{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/elasticore-hook.sh\" pre-edit codex",
            "commandWindows": "& \"$env:ProgramFiles\\Git\\bin\\bash.exe\" \"$env:PLUGIN_ROOT/hooks/elasticore-hook.sh\" pre-edit codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/elasticore-hook.sh\" pre-bash codex",
            "commandWindows": "& \"$env:ProgramFiles\\Git\\bin\\bash.exe\" \"$env:PLUGIN_ROOT/hooks/elasticore-hook.sh\" pre-bash codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/elasticore-hook.sh\" post-edit codex",
            "commandWindows": "& \"$env:ProgramFiles\\Git\\bin\\bash.exe\" \"$env:PLUGIN_ROOT/hooks/elasticore-hook.sh\" post-edit codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/elasticore-hook.sh\" post-bash codex",
            "commandWindows": "& \"$env:ProgramFiles\\Git\\bin\\bash.exe\" \"$env:PLUGIN_ROOT/hooks/elasticore-hook.sh\" post-bash codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/elasticore-hook.sh\" stop codex",
            "commandWindows": "& \"$env:ProgramFiles\\Git\\bin\\bash.exe\" \"$env:PLUGIN_ROOT/hooks/elasticore-hook.sh\" stop codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
